# Copy to .env and fill in local credentials. Do not commit the completed file.

# Required before authenticated MT5 control endpoints can be used.
SPIDY_API_KEY=replace-with-a-long-random-value

# Required only when spidy_ai/main.py connects directly to MT5.
SPIDY_MT5_LOGIN=
SPIDY_MT5_PASSWORD=
SPIDY_MT5_SERVER=
SPIDY_MT5_PATH=

# Set to 1 only when you intentionally want persisted auto-trading enabled on startup.
SPIDY_ENABLE_AUTO_TRADING=0

# Closed-trade retraining cadence. Models only deploy after their chronological
# holdout passes the risk-adjusted gate.
SPIDY_ML_RETRAIN_HOURS=24

# Optional InfluxDB metrics (required when starting docker-compose.yml).
SPIDY_INFLUXDB_PASSWORD=
INFLUXDB_TOKEN=

# Required only for the Shoonya bridge.
SHOONYA_USER=
SHOONYA_PWD=
SHOONYA_TOTP_SECRET=
SHOONYA_FACTOR2=
SHOONYA_VC=
SHOONYA_API_KEY=
SHOONYA_IMEI=
